PORT=5000
MONGO_URI=mongodb://localhost:27017/qr-attendance

# Secret for staff login JWTs
JWT_SECRET=change-me-staff-jwt-secret

# Secret for rotating QR check-in tokens (keep separate from JWT_SECRET)
QR_SECRET=change-me-qr-secret

# Location identifier embedded in the QR token (just a label, e.g. for multi-branch setups)
LOCATION_ID=office-abuja

# 24h HH:mm cutoff — check-ins after this are marked "late"
LATE_CUTOFF=09:00

# Office coordinates staff must be within range of to check in.
# Get these from Google Maps: right-click your office location -> click the lat,lng that appears.
OFFICE_LAT=
OFFICE_LNG=
MAX_DISTANCE_METERS=150

# Used only by the seed:admin script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_PHONE=+2340000000000
SEED_ADMIN_NAME=Admin
